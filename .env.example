# Example environment variables for NoteFlow AI
# Copy to `.env` and fill values before running the app

# OpenAI API key (required for embeddings & LLM calls)
OPENAI_API_KEY=your_openai_api_key_here

# Chroma persistence directory (optional)
CHROMA_PERSIST_DIR=./chroma_db

# Host/port for uvicorn (optional)
HOST=127.0.0.1
PORT=8000

# JWT auth settings
JWT_SECRET_KEY=change-this-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Registration is disabled by default for production safety.
# Set ALLOW_REGISTER=true only when you want to allow new users.
ALLOW_REGISTER=false

# Payments
PAYMENT_PROVIDER=toss
FRONTEND_BASE_URL=http://127.0.0.1:3000

# Toss Payments
# Keep test/live keys separated. The backend still uses the internal confirm
# flow until the real Toss Confirm API is connected.
TOSS_PAYMENTS_ENV=test
TOSS_TEST_SECRET_KEY=test_sk_your_toss_secret_key
TOSS_LIVE_SECRET_KEY=live_sk_your_toss_secret_key
TOSS_CHECKOUT_PATH=/payments/toss/ready
