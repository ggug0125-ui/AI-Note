# Example environment variables for NoteFlow AI
# Copy to `.env` and fill values before running the app

# OpenAI API key (required for embeddings & LLM calls)
OPENAI_API_KEY=your_openai_api_key_here

# Chroma persistence directory (optional)
CHROMA_PERSIST_DIR=./chroma_db

# Host/port for uvicorn (optional)
HOST=127.0.0.1
PORT=8000

# JWT auth settings
JWT_SECRET_KEY=change-this-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
